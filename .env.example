# General application settings
INKY_ENV=development
INKY_LOG_LEVEL=INFO

# Fixed display profile. These are safe defaults, not secrets.
INKY_DISPLAY_ID=inky-main
INKY_DISPLAY_NAME=Main Inky Display
INKY_DISPLAY_ORIENTATION=landscape
INKY_DISPLAY_ROTATION_DEGREES=0
INKY_DISPLAY_TIME_ZONE=Europe/Copenhagen

# Docker host settings
INKY_HOST_PORT=8000
INKY_DATABASE_URL=postgresql+psycopg://inky:replace-with-local-password@postgres:5432/inky
INKY_REDIS_URL=redis://redis:6379/0

# Pi agent connection. The Pi makes outbound requests to this Docker host; it does
# not listen for incoming connections. Use the host's LAN address, not localhost.
INKY_ADVERTISED_HOST=http://192.168.0.10
INKY_ADVERTISED_PORT=8000
INKY_AGENT_AUTH_REQUIRED=false
# Only needed if INKY_AGENT_AUTH_REQUIRED=true. Never commit a real device token.
INKY_AGENT_DEVICE_TOKEN=replace-with-a-long-random-device-token
INKY_AGENT_SERVER_URL=http://192.168.0.10:8000
INKY_AGENT_DISPLAY_ID=inky-main
INKY_AGENT_DATA_DIR=/var/lib/inky-agent
INKY_AGENT_HARDWARE_ENABLED=true
INKY_AGENT_POLL_INTERVAL_SECONDS=30
INKY_AGENT_HEARTBEAT_INTERVAL_SECONDS=60

# Future Compose database service settings. Replace before enabling that service.
POSTGRES_DB=inky
POSTGRES_USER=inky
POSTGRES_PASSWORD=replace-with-a-local-development-password
