# Home tool settings
INKY_LOG_LEVEL=INFO

# Fixed panel settings. The display is always this one panel.
INKY_DISPLAY_ID=inky-main
INKY_DISPLAY_NAME=Main Inky Display
INKY_DISPLAY_ORIENTATION=landscape
INKY_DISPLAY_ROTATION_DEGREES=0
INKY_DISPLAY_TIME_ZONE=Europe/Copenhagen

# Docker host
INKY_HOST_PORT=8000

# Optional Pi API authentication. The Pi's own configuration holds its server
# URL and polling intervals; the host never makes a connection to the Pi.
INKY_AGENT_AUTH_REQUIRED=false
# Only needed when INKY_AGENT_AUTH_REQUIRED=true.
INKY_AGENT_DEVICE_TOKEN=replace-with-a-long-random-device-token
